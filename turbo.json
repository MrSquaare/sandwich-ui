{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/",
        ".astro/",
        "storybook-static/",
        "node_modules/.cache/"
      ]
    },
    "preview": {
      "cache": false
    },
    "check": {
      "cache": false
    },
    "check:fix": {
      "cache": false
    },
    "clean": {
      "cache": false,
      "outputs": [
        "dist/",
        ".astro/",
        "storybook-static/",
        "node_modules/.cache/"
      ]
    }
  }
}
