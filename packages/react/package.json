{
  "name": "@sandwich-ui/react",
  "version": "0.4.6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "panda codegen",
    "dev:codegen": "panda codegen --watch",
    "dev:dist": "tsdown --watch",
    "dev": "conc npm:dev:codegen npm:dev:dist",
    "prebuild": "del-cli dist/ && panda codegen",
    "build": "tsdown",
    "check": "eslint . && prettier --check .",
    "check:fix": "eslint . --fix && prettier --write .",
    "clean": "del-cli dist/ styled-system/ node_modules/.cache/"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2"
  },
  "peerDependencies": {
    "@sandwich-ui/core": "workspace:*",
    "@sandwich-ui/styled-system": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.3",
    "@sandwich-ui/core": "workspace:*",
    "@sandwich-ui/eslint-config": "workspace:*",
    "@sandwich-ui/eslint-config-react": "workspace:*",
    "@sandwich-ui/styled-system": "./styled-system",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3"
  }
}
