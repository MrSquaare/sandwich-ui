{
  "name": "@sandwich-ui/core",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./preset": {
      "require": "./dist/preset/index.cjs",
      "import": "./dist/preset/index.mjs"
    },
    "./plugin": {
      "require": "./dist/plugin/index.cjs",
      "import": "./dist/plugin/index.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "panda codegen",
    "dev:codegen": "panda codegen --watch",
    "dev:dist": "tsdown --watch --no-clean",
    "dev:css": "panda cssgen -o dist/style.css --watch",
    "dev": "conc npm:dev:codegen npm:dev:dist npm:dev:css",
    "prebuild": "del-cli dist/ && panda codegen",
    "build": "tsdown && panda cssgen -o dist/style.css",
    "check": "eslint . && prettier --check .",
    "check:fix": "eslint . --fix && prettier --write .",
    "clean": "del-cli dist/ styled-system/ node_modules/.cache/"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.3",
    "@pandacss/types": "^1.11.3",
    "@sandwich-ui/eslint-config": "workspace:*",
    "@types/node": "^25.9.4",
    "concurrently": "^10.0.3",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3"
  }
}
